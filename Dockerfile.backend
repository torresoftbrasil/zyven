FROM maven:3.9-eclipse-temurin-25 AS build
WORKDIR /workspace
COPY backend/pom.xml backend/pom.xml
COPY backend/src backend/src
RUN mvn -f backend/pom.xml --batch-mode --no-transfer-progress package -DskipTests

FROM eclipse-temurin:25-jre-alpine
WORKDIR /app
RUN addgroup -S zyven && adduser -S zyven -G zyven
COPY --from=build /workspace/backend/target/*.jar /app/zyven.jar
USER zyven
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/zyven.jar"]

